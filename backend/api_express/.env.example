PORT=5000

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# RAG Microservice — internal docker-compose service name, not localhost
# (local dev without Docker: http://localhost:8000)
RAG_SERVICE_URL=http://rag_service:8000
MAX_UPLOAD_SIZE=10MB

MONGODB_URI=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Auth (JWT + Google OAuth)
JWT_SECRET=
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
# Same Google OAuth Client ID as the frontend's GOOGLE_CLIENT_ID — used to verify token audience
GOOGLE_CLIENT_ID=
# Public site origin — must match DOMAIN in the root .env (used for CORS)
# (local dev: http://localhost:3000)
FRONTEND_URL=https://yourdomain.com
