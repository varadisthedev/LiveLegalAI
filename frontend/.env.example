# Public origin (same value as DOMAIN in the root .env). This is baked into
# the client bundle at `docker compose build` time — see docker-compose.yaml.
# (local dev without Docker: http://localhost:5000)
NEXT_PUBLIC_BACKEND_URL=https://yourdomain.com

# (local dev without Docker: http://localhost:3000)
NEXTAUTH_URL=https://yourdomain.com
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Create an OAuth 2.0 Client ID in Google Cloud Console (APIs & Services > Credentials)
# Authorized redirect URI: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
