# Read by docker-compose.yaml. Copy to .env and fill in before `docker compose up`.

# Your domain, pointed at this VPS's IP via an A record (e.g. app.example.com).
# Caddy uses this to request a free Let's Encrypt certificate automatically.
DOMAIN=yourdomain.com

# Used for Let's Encrypt account registration / expiry notices.
CADDY_EMAIL=you@example.com

# Public origin the browser calls — gets baked into the frontend build.
# Must be https://<DOMAIN> above.
NEXT_PUBLIC_BACKEND_URL=https://yourdomain.com
